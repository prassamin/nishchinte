{
  "name": "@nishchinte/email",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "nodemailer": "^10.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  }
}
